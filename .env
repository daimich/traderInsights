# Environment Variables for StockInsight
# Copy this file to .env and add your actual API keys
# NEVER commit .env to version control

# Alpha Vantage API Key (Required)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key_here

# News API Key (Optional - for sentiment analysis)
# Get your key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# IEX Cloud API Key (Optional - alternative data source)
# Get your key at: https://iexcloud.io/sign-up
IEX_CLOUD_KEY=your_iex_cloud_key_here

# Polygon.io API Key (Optional - for additional market data)
# Get your key at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# Development/Production flag
NODE_ENV=development

# Rate limiting (requests per minute)
API_RATE_LIMIT=5